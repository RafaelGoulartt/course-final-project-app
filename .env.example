# Copie este arquivo para .env.local (que o git ignora) para escolher a API do app.
# Depois de mudar, reinicie o Metro com: npx expo start -c
# Se nada for definido, o app usa a API publicada na Vercel.

# API local, com o celular no cabo (antes rode: adb reverse tcp:3001 tcp:3001)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# API local pelo Wi-Fi (troque pelo IPv4 do PC, veja com ipconfig)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3001/api

# API local no emulador Android
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api

# API publicada (Vercel)
# EXPO_PUBLIC_API_BASE_URL=https://course-final-project-eta.vercel.app/api
